# ============================================================================
# AGENTIC TESTING WORKFLOW - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# LLM PROVIDER (choose one)
# ----------------------------------------------------------------------------

# Anthropic Claude (recommended)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OR OpenAI GPT (alternative)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# ----------------------------------------------------------------------------
# NOTES
# ----------------------------------------------------------------------------
# 
# If no API key is set, the workflow runs in SIMULATION mode.
# This is useful for testing the workflow structure without API costs.
#
# Model options:
#   Anthropic: claude-sonnet-4-20250514 (recommended), claude-opus-4-20250514
#   OpenAI: gpt-4o, gpt-4-turbo-preview
#
# Estimated costs per story (Claude Sonnet):
#   - Planning: ~$0.01-0.02
#   - Gherkin:  ~$0.005-0.01  
#   - Code:     ~$0.01-0.02
#   - Total:    ~$0.03-0.05
