{
  "name": "ai-test-agents-lab",
  "version": "1.0.0",
  "description": "Agentic testing workflow with planning and execution agents",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx app/server.ts",
    "build": "tsc",
    "start": "node dist/app/server.js",
    
    "agent": "tsx --env-file=.env src/cli.ts",
    "agent:plan": "tsx --env-file=.env src/cli.ts plan",
    "agent:cases": "tsx --env-file=.env src/cli.ts cases",
    "agent:code": "tsx --env-file=.env src/cli.ts code",
    "agent:full": "tsx --env-file=.env src/cli.ts full",
    "agent:list": "tsx --env-file=.env src/cli.ts list",
    "agent:help": "tsx --env-file=.env src/cli.ts help",
    
    "demo": "tsx --env-file=.env src/cli.ts demo",
    "demo:quick": "tsx --env-file=.env src/cli.ts full story-001-delete-user --skip-approval",
    
    "test:llm": "tsx --env-file=.env src/test-llm.ts",
    "test:integration": "tsx --env-file=.env src/test-integration.ts",
    "test:workflow": "tsx --env-file=.env src/test-workflow.ts",
    "test": "echo \"No tests configured yet\" && exit 0",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "testing",
    "ai",
    "agents",
    "automation",
    "cypress",
    "gherkin"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
